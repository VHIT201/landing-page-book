# --- Bắt buộc ---
# Postgres. Lấy từ Neon (neon.tech) hoặc Supabase — dùng connection string "pooled".
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Mật khẩu vào /admin (Basic Auth). Chưa đặt = khu admin bị khoá 503.
ADMIN_PASSWORD="doi-mat-khau-nay"
ADMIN_USER="admin"

# --- Tuỳ chọn ---
# Giá 1 cuốn (VND) + phí ship phẳng. Bỏ trống = 198000 / 0.
PRICE_UNIT=198000
SHIPPING_FLAT=0

# Telegram báo đơn mới (bỏ trống = không gửi, vẫn chạy bình thường).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dùng cho link tuyệt đối nếu cần
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
