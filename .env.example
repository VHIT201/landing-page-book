# --- Bắt buộc ---
# Postgres. Lấy từ Neon (neon.tech) hoặc Supabase — dùng connection string "pooled".
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Đăng nhập /admin (form + session cookie). Chưa đặt = không đăng nhập được.
ADMIN_USER="admin"
ADMIN_PASSWORD="doi-mat-khau-nay"
# Khoá ký session, >= 16 ký tự ngẫu nhiên:  openssl rand -hex 32
AUTH_SECRET="thay-bang-chuoi-ngau-nhien-dai"

# --- Tuỳ chọn ---
# Giá 1 cuốn (VND) + phí ship phẳng. Bỏ trống = 198000 / 0.
PRICE_UNIT=198000
SHIPPING_FLAT=0

# Telegram báo đơn mới (bỏ trong = không gửi, vẫn chạy bình thường).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dùng cho link tuyệt đối nếu cần
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ============================================
# SEPAY — bật/tắt thanh toán chuyển khoản tự động
# ============================================
# Bật/tắt tích hợp SePay (true/false). Mặc định: false.
SEPAY_ENABLED=false

# Phương thức auth webhook: "api_key" | "hmac_sha256" | "none"
# - hmac_sha256:  SePay gửi `X-SePay-Signature: sha256=<hex>` (khuyến nghị production)
SEPAY_AUTH_METHOD=hmac_sha256

# Nếu SEPAY_AUTH_METHOD=hmac_sha256, đặt giá trị tương ứng.
# Lấy từ https://my.sepay.vn → Integrations → Webhooks → Security
SEPAY_WEBHOOK_SECRET=

# Thông tin tài khoản ngân hàng NHẬN tiền (cấu hình 1 lần trong SePay dashboard).
# Sẽ hiển thị cho khách ở trang "vừa đặt" để họ biết chuyển khoản vào đâu.
SEPAY_BANK_CODE=
SEPAY_BANK_ACCOUNT=
SEPAY_BANK_ACCOUNT_NAME=

# API endpoint SePay v2 (chỉ cần cho phase 2 — reconciliation)
# Mặc định: https://userapi.sepay.vn/v2
SEPAY_API_URL=
